# พอร์ตที่ API จะรัน
PORT=3000

# การเชื่อมต่อ PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# ใส่รหัสผ่าน PostgreSQL ของคุณเอง (รหัสที่ตั้งไว้ตอนติดตั้ง PostgreSQL)
# ถ้ารหัสมีเครื่องหมาย # ให้ครอบด้วยเครื่องหมายคำพูด เช่น DB_PASSWORD="abc#123"
# ห้าม commit ไฟล์ .env ขึ้น GitHub (มีอยู่ใน .gitignore แล้ว)
DB_PASSWORD=
DB_NAME=todo_db

# origin ของ frontend ที่อนุญาตให้เรียก API (Vite dev server)
CORS_ORIGIN=http://localhost:5173

									"});",
									"pm.test(\"Content-Type is application/json\", function () {",
									"  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});",
									"pm.test(\"Body is a Todo object\", function () {",
									"  const todo = pm.response.json();",
									"  pm.expect(todo).to.have.all.keys(\"id\", \"title\", \"completed\", \"createdAt\", \"updatedAt\");",
									"  pm.expect(todo.id).to.be.a(\"number\");",
									"  pm.expect(todo.title).to.be.a(\"string\");",
									"  pm.expect(todo.completed).to.be.a(\"boolean\");",
									"  pm.expect(todo.createdAt).to.be.a(\"string\");",
									"  pm.expect(todo.updatedAt).to.be.a(\"string\");",
									"  pm.expect(Date.parse(todo.createdAt), \"createdAt is a valid date\").to.not.be.NaN;",
									"  pm.expect(Date.parse(todo.updatedAt), \"updatedAt is a valid date\").to.not.be.NaN;",
									"});",
									"pm.test(\"Title is updated and trimmed\", function () {",
									"  const todo = pm.response.json();",
									"  pm.expect(todo.id).to.equal(Number(pm.collectionVariables.get(\"todoId\")));",
									"  pm.expect(todo.title).to.equal(\"Updated by Postman\");",
									"  pm.expect(todo.completed).to.equal(false);",
									"});",
									"pm.test(\"updatedAt is not earlier than createdAt\", function () {",
									"  const todo = pm.response.json();",
									"  pm.expect(Date.parse(todo.updatedAt)).to.be.at.least(Date.parse(todo.createdAt));",
									"});"
								]
							}
						}
					],

{
	"info": {
		"_postman_id": "3f6b8f0e-6c1a-4f43-9a52-2d7c1b0e9a41",
		"name": "Todo API",
		"description": "ชุดทดสอบ RESTful API ของ Todo List (CRUD + validation)\n\nวิธีใช้:\n1. เปิด API server ก่อน (ค่าเริ่มต้น http://localhost:3000)\n2. Postman: Import ไฟล์นี้ แล้วกด Run collection\n3. Command line: npm run test:api (หรือ npx -y newman run postman/Todo-API.postman_collection.json)\n\nถ้า server ไม่ได้อยู่ที่ port 3000 ให้แก้ตัวแปร baseUrl ในแท็บ Variables ของ collection\nชุดทดสอบนี้ลบ todo ทุกตัวที่สร้างขึ้นเองเมื่อรันจบ จึงรันซ้ำได้ทั้งกับฐานข้อมูลว่างและที่มีข้อมูลอยู่แล้ว",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. CRUD (happy path)",
			"description": "ทดสอบการใช้งานปกติครบวงจร: สร้าง > อ่าน > แก้ไข > ทำเครื่องหมายเสร็จ > ลบ (ต้องรันตามลำดับ)",
			"item": [
				{
					"name": "Create todo",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// สร้างชื่อ todo ที่ไม่ซ้ำกันในแต่ละรอบ (ใช้ได้ทั้งตอน DB ว่างและมีข้อมูลอยู่แล้ว)",
									"pm.variables.set(\"newTitle\", \"Postman test todo \" + Date.now());"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"  pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Content-Type is application/json\", function () {",
									"  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});",
									"pm.test(\"Body is a Todo object\", function () {",
									"  const todo = pm.response.json();",
									"  pm.expect(todo).to.have.all.keys(\"id\", \"title\", \"completed\", \"createdAt\", \"updatedAt\");",
									"  pm.expect(todo.id).to.be.a(\"number\");",
									"  pm.expect(todo.title).to.be.a(\"string\");",
									"  pm.expect(todo.completed).to.be.a(\"boolean\");",
									"  pm.expect(todo.createdAt).to.be.a(\"string\");",
									"  pm.expect(todo.updatedAt).to.be.a(\"string\");",
									"  pm.expect(Date.parse(todo.createdAt), \"createdAt is a valid date\").to.not.be.NaN;",
									"  pm.expect(Date.parse(todo.updatedAt), \"updatedAt is a valid date\").to.not.be.NaN;",
									"});",
									"pm.test(\"Title is trimmed and completed is false\", function () {",
									"  const todo = pm.response.json();",
									"  pm.expect(todo.title).to.equal(pm.variables.get(\"newTitle\"));",
									"  pm.expect(todo.completed).to.equal(false);",
									"});",
									"",
									"// เก็บ id ของ todo ที่สร้างไว้ในตัวแปร todoId เพื่อใช้ใน request ถัดไป",
									"if (pm.response.code === 201) {",
									"  pm.collectionVariables.set(\"todoId\", pm.response.json().id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/todos",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"todos"
							]
						},
						"description": "สร้าง todo ใหม่ (ใส่ช่องว่างหน้า-หลังชื่อไว้ เพื่อทดสอบว่า server ตัดช่องว่างให้) ต้องได้ 201 และ completed = false จากนั้นเก็บ id ไว้ในตัวแปร todoId",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"   {{newTitle}}   \"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				},
				{
					"name": "Get all todos",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"  pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Content-Type is application/json\", function () {",
									"  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});",
									"pm.test(\"Body is an array of Todo objects\", function () {",
									"  const todos = pm.response.json();",
									"  pm.expect(todos).to.be.an(\"array\");",
									"  todos.forEach((todo) => {",
									"    pm.expect(todo).to.have.all.keys(\"id\", \"title\", \"completed\", \"createdAt\", \"updatedAt\");",
									"    pm.expect(todo.id).to.be.a(\"number\");",
									"    pm.expect(todo.title).to.be.a(\"string\");",
									"    pm.expect(todo.completed).to.be.a(\"boolean\");",
									"    pm.expect(todo.createdAt).to.be.a(\"string\");",
									"    pm.expect(todo.updatedAt).to.be.a(\"string\");",
									"    pm.expect(Date.parse(todo.createdAt), \"createdAt is a valid date\").to.not.be.NaN;",
									"    pm.expect(Date.parse(todo.updatedAt), \"updatedAt is a valid date\").to.not.be.NaN;",
									"  });",
									"});",
									"pm.test(\"List contains the todo we just created\", function () {",
									"  const ids = pm.response.json().map((todo) => todo.id);",
									"  pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"todoId\")));",
									"});",
									"",
									"// ตรวจลำดับ: ตัวก่อนหน้าต้องสร้างทีหลัง (หรือพร้อมกับ) ตัวถัดไปเสมอ",
									"pm.test(\"Todos are ordered newest first\", function () {",
									"  const todos = pm.response.json();",
									"  for (let i = 1; i < todos.length; i++) {",
									"    pm.expect(Date.parse(todos[i - 1].createdAt)).to.be.at.least(Date.parse(todos[i].createdAt));",
									"  }",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/todos",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"todos"
							]
						},
						"description": "ดึง todo ทั้งหมด ต้องได้ 200 เป็น array ของ Todo ที่มี todo ที่เพิ่งสร้างอยู่ด้วย และเรียงจากใหม่ไปเก่า (createdAt มากไปน้อย)"
					},
					"response": []
				},
